  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.38",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.8",
    "postcss-preset-mantine": "^1.18.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^4.0.18"
