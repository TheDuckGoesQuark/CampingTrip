{
  "name": "jordanscamp",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:campsite": "pnpm --filter campsite dev",
    "build:campsite": "pnpm --filter campsite build",
    "dev:photobroom": "pnpm --filter photobroom dev",
    "build:photobroom": "pnpm --filter photobroom build",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:campsite": "pnpm --filter campsite test",
    "test:photobroom": "pnpm --filter photobroom test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check-deps": "depcruise apps packages",
    "ds-guard": "node scripts/ds-guard/ds-guard.mjs",
    "ds-guard:test": "node --test scripts/ds-guard/ds-guard.test.mjs",
    "validate": "pnpm fmt:check && pnpm lint && pnpm spell && pnpm check-deps && pnpm ds-guard && pnpm -r exec tsc -b && pnpm -r test && pnpm ds-guard:test",
    "spell": "cspell lint --no-progress .",
    "spell:words": "cspell lint --no-progress --words-only --unique . | sort -f"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "cspell": "^10.3.3",
    "dependency-cruiser": "^17.4.3",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.72.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
