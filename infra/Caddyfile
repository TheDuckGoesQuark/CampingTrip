jordanscamp.site {
    root * /opt/jordanscamp/webapp

    encode zstd gzip

    # Only /assets is fingerprinted, so only it can promise immutable bytes.
    @immutable path /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    @media path /models/* /images/* /draco/*
    header @media Cache-Control "public, max-age=604800"

    # Caching the shell, a prerendered page or the CV's PDF pins visitors to a
    # stale deploy: none of them is fingerprinted.
    @shell path / *.html /cv.pdf
    header @shell Cache-Control "no-cache"

    # Short enough to say aloud or put on paper.
    redir /cv /blog/cv.html permanent

    # Same-origin, so the form posts without CORS ever entering the picture.
    #
    # The URL is the one Terraform prints as `contact_function_url`; its id is
    # generated at creation, so it cannot be derived and has to be copied here
    # after the function URL exists.
    #
    # A Function URL answers 403 to a request whose Host is not its own, and
    # Caddy's default is to pass the incoming Host through — hence the override.
    # Caddy 2.11 made this automatic for https upstreams and warns the line is
    # unnecessary, but still honours it, so it stays: correct on either version
    # beats correct on the one this box happens to run.
    handle /api/contact {
        reverse_proxy https://k6kucegvmyqo3npqoivlf5zg6q0wubku.lambda-url.eu-west-2.on.aws {
            header_up Host {upstream_hostport}
        }
    }

    # Wrapped in `handle` so the rewrite below cannot reach `/api/contact`:
    # `try_files` runs ahead of every `handle` in Caddy's directive order, so at
    # the top level it would turn that path into `/index.html` and the proxy
    # matcher above would never see it.
    handle {
        # A prerendered page answers its own URL; the shell is the fallback.
        try_files {path} {path}.html /index.html
        file_server
    }
}

# One canonical hostname. Serving the same site on both would give every page
# two addresses, which splits search ranking and makes analytics lie; a 301 to
# the apex keeps www working for anyone who types it out of habit without
# creating a second copy of the site. Caddy gets its own certificate for this
# name automatically over HTTP-01.
www.jordanscamp.site {
    redir https://jordanscamp.site{uri} permanent
}
